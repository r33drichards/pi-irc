# docker compose reads this as .env
ANTHROPIC_API_KEY=
# Or a custom provider (see config/models.example.json) + its key:
# PI_DEFAULT_PROVIDER=litellm
# PI_DEFAULT_MODEL=medium
# PI_MODELS_JSON={"providers":{"litellm":{"baseUrl":"https://litellm.example/v1","api":"openai-completions","apiKey":"$LITELLM_API_KEY","models":[{"id":"medium"}]}}}
# LITELLM_API_KEY=
IRC_NICK=pi
IRC_CHANNELS=#pi
